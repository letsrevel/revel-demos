# --- secrets -----------------------------------------------------------
# .env holds ELEVENLABS_API_KEY. NEVER commit it. Copy .env.example instead.
.env
.env.local
*.pem
!fake-secrets/*.pem

# --- dependencies ------------------------------------------------------
node_modules/

# --- Python venv (mlx-audio, macOS-only optional engine) ----------------
.venv/
__pycache__/

# --- argo working state ------------------------------------------------
# TTS clips, recordings, timing, shader caches. Regenerated by the pipeline.
.argo/
test-results/
playwright-report/
blob-report/
.playwright/
logs/

# --- rendered media (large, regenerate with `npm run pipeline`) ---------
videos/
tts-samples/*.wav
tts-samples/*.mp3
tts-samples/*.m4a
*.mp4
*.webm
*.gif
*.srt
*.vtt

# assets/ IS committed — brand marks (png/b64) are inputs, not output.
!assets/**

# --- OS / editor -------------------------------------------------------
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# Generated at setup by scripts/make-fake-secrets.sh (npm install runs it).
# NOT committed: GitHub's push protection rejects anything shaped like a Google
# service-account key, even a self-generated worthless one. It is regenerated
# on any machine in a second, so nothing is lost.
fake-secrets/google-wallet-sa.json
