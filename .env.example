# =============================================================================
#  Copy this file to `.env` before you start:   cp .env.example .env
# =============================================================================
#
#  `.env` is git-ignored — nothing you put in it is ever committed.
#  Everything here is optional: with no `.env` at all, the stack still comes up
#  and the free local voice still works. You need this file for two things —
#  changing the image versions, and using the paid ElevenLabs voice.
#
#  Both docker compose and the video pipeline read this same file.


# -----------------------------------------------------------------------------
#  Image versions
# -----------------------------------------------------------------------------
#  Which release of Revel the demo environment runs.
#
#  These are the latest releases as of 2026-09-06. Backend 2.8.0 is the first
#  release carrying the `bootstrap_demo_video` seeding command used by the demo
#  scenarios, so do not go below it — an older tag makes the bootstrap step warn
#  and seed only the standard demo data.
#
#  After changing either line:   docker compose pull && docker compose up -d
#
#  Watch the asymmetry — it is easy to get wrong:
#      backend tags have NO leading "v"    → 2.9.0
#      frontend tags DO have it            → v2.8.2
#  Available tags: https://github.com/orgs/letsrevel/packages

REVEL_BACKEND_TAG=2.9.0
REVEL_FRONTEND_TAG=v2.8.2


# -----------------------------------------------------------------------------
#  Voice (text-to-speech)
# -----------------------------------------------------------------------------
#  Which voice engine narrates the videos.
#
#    kokoro      (default) Local, free, unlimited, runs on your own machine.
#                Draft every video with this one.
#    elevenlabs  The polished paid voice. Costs money per character, so only
#                use it for the final pass once the words are final.
#    mlx         Apple-Silicon Macs only. Ignore this on Linux.
#
#  You normally leave this unset and pass it per-command instead:
#      ARGO_TTS=elevenlabs npx argo pipeline clip-intro
#
# ARGO_TTS=kokoro

#  Your ElevenLabs API key, needed ONLY for ARGO_TTS=elevenlabs.
#  Get it from https://elevenlabs.io → Profile → API Keys.
#  Keep it here and nowhere else — never paste it into a script or a chat.
# ELEVENLABS_API_KEY=your-key-here

#  Override the speaker. Rarely needed — each engine already has a chosen
#  default (Kokoro "af_heart", ElevenLabs "Will"). ElevenLabs voices are IDs,
#  not names.
# ARGO_VOICE=af_heart


# -----------------------------------------------------------------------------
#  Where things live (only change these if you moved a port)
# -----------------------------------------------------------------------------
# BASE_URL=http://localhost:5173
# API_URL=http://localhost:8000
# MAILPIT_URL=http://localhost:8025
